<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and restore rules for API 31+ (Android 12+).

  MVP privacy choice: exclude the local Room database from cloud backup and
  device-to-device transfer. Manual export/import (CSV) remains the user-controlled
  copy path. Database file name: grocery_list.db (AppDatabase.DB_NAME).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="grocery_list.db" />
        <exclude domain="database" path="grocery_list.db-shm" />
        <exclude domain="database" path="grocery_list.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="grocery_list.db" />
        <exclude domain="database" path="grocery_list.db-shm" />
        <exclude domain="database" path="grocery_list.db-wal" />
    </device-transfer>
</data-extraction-rules>
