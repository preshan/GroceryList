<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup (fullBackupContent) for API 30 and below, and as a companion to
  data_extraction_rules on newer devices.

  MVP privacy choice: do not back up the local Room database (grocery_list.db).
  app_settings and all catalogue/shopping data live in that database.
  See AppDatabase.DB_NAME in code.
-->
<full-backup-content>
    <exclude domain="database" path="grocery_list.db" />
    <exclude domain="database" path="grocery_list.db-shm" />
    <exclude domain="database" path="grocery_list.db-wal" />
</full-backup-content>
